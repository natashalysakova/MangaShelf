@page "/"
@using MangaShelf.BL.Dto
@using MangaShelf.BL.Contracts
@inject IVolumeService VolumeService
@inject IUiLocalizationService Localizer

<PageTitle>@Localizer["Home"]</PageTitle>

<HeaderComponent Header="@Localizer["NewManga"]" MoreUrl="/catalog?newReleases=true" />
<MangaLine Volumes="@NewReleasedManga" />

<HeaderComponent Header="@Localizer["NewPreorders"]" MoreUrl="/catalog?preorders=true" />
<MangaLine Volumes="@Preorders" />


@code
{
    private IEnumerable<CardVolumeDto>? NewReleasedManga { get; set; } = Enumerable.Empty<CardVolumeDto>();
    private IEnumerable<CardVolumeDto>? Preorders { get; set; } = Enumerable.Empty<CardVolumeDto>();
    private int itemCount = 12;

    protected override async Task OnInitializedAsync()
    {
        NewReleasedManga = await VolumeService.GetNewestReleases(itemCount);
        Preorders = await VolumeService.GetLatestPreorders(itemCount);
    }
}
