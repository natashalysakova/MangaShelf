@page "/admin/parsers"
@using MangaShelf.DAL.System.Models
@using System.Collections.ObjectModel

@inject IParserReadService parserService;
@inject IJobRequester jobManager;
@inject IJobUpdateService jobUpdateService;
@implements IDisposable


<MudGrid Justify="Justify.SpaceAround" Class="mb-4">
    <MudItem xs="12">
        <MudPaper Class="p-4 mb-4 mt-4">
            <h3>Parsers</h3>
            <MudStack Justify="Justify.Center" AlignItems="AlignItems.Center" Row>
                <MudTextField @bind-Value="url" Label="Paste URL for parsing" Variant="Variant.Filled"></MudTextField>
                <MudButton OnClick="RunForUrl" Color="Color.Primary" Variant="Variant.Filled">Run</MudButton>
            </MudStack>
        </MudPaper>
    </MudItem>

    @if (statuses != null)
    {
        @foreach (ParserStatusDto parser in statuses)
        {
            <MudItem Style="width: 250px;  height: 285px;">
                <MudPaper Class="p-4">
                    @{

                        var color = parser.Status switch
                        {
                            ParserStatus.Idle when parser.IsActive => Color.Default,
                            ParserStatus.Idle when !parser.IsActive => Color.Error,
                            ParserStatus.Parsing => Color.Success,
                            ParserStatus.GatheringVolumes => Color.Info,
                            ParserStatus.Waiting => Color.Warning,
                            _ => Color.Default
                        };
                    }

                    <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center">
                        <MudStack Row>
                            <MudTooltip Text="@(parser.IsActive ? "Disable" : "Enable")">
                                <MudIconButton OnClick="(() => ToggleParserState(parser.Id))" Size="Size.Small"
                                               Icon="@(parser.IsActive ? Icons.Material.Rounded.Stop : Icons.Material.Rounded.PlayCircle)"
                                               Color="@(parser.IsActive ? Color.Error : Color.Success)">
                                </MudIconButton>
                            </MudTooltip>

                            <MudText Typo="Typo.subtitle1" Color="@(parser.IsActive ? Color.Success : Color.Error)">@parser.ParserName</MudText>
                        </MudStack>

                        <MudText Typo="Typo.h6" Color="@color"> @parser.Status </MudText>


                        @if (parser.Status == ParserStatus.Parsing)
                        {

                            <MudProgressCircular Color="@color" Size="Size.Large" Value="@parser.Progress">
                                <ChildContent>
                                    @parser.Progress.ToString("N2")
                                </ChildContent>
                            </MudProgressCircular>
                        }
                        else if (parser.Status == ParserStatus.Idle)
                        {

                            <MudIconButton Class="@(parser.Status == ParserStatus.Idle ? "visible" : "hidden")" OnClick="(() => RunParser(parser.Id))" Size="Size.Large" Icon="@Icons.Material.Rounded.PlayArrow" Color="Color.Success" Disabled="@(!parser.IsActive || parsersPendingSubmission.Contains(parser.Id))"></MudIconButton>
                        }
                        else
                        {
                            <MudProgressCircular Color="@color" Size="Size.Large" Indeterminate="true">
                                <ChildContent>
                                    @if (parser.Progress > 0)
                                    {
                                        @parser.Progress.ToString("N2")
                                    }
                                </ChildContent>
                            </MudProgressCircular>
                        }

                        <MudStack Row Spacing="1">
                            <MudText Typo="Typo.caption">Next Run in</MudText>
                            <MudText Typo="Typo.caption">@GetCountdownText(parser.Id)</MudText>
                        </MudStack>
                    </MudStack>
                </MudPaper>
            </MudItem>
        }
    }
</MudGrid>

<style>
    .cell-Running {
        color: var(--mud-palette-info) !important;
    }

    .cell-Finished {
        color: var(--mud-palette-success) !important;
    }

    .cell-Error {
        color: var(--mud-palette-error) !important;
    }

    .cell-Waiting {
        color: var(--mud-palette-warning) !important;
    }

    .cell-Cancelled {
        color: var(--mud-palette-text-secondary) !important;
    }
</style>
<MudStack Row Spacing="2" Class="mb-4">
    <MudButton Variant="Variant.Filled" OnClick="@(() => { showPanel = !showPanel; })">@(showPanel ? "Hide panel" : "Show panel")</MudButton>
    @{
        var cancellableJobsCount = jobs?.Count(j => j.Status == RunStatus.Waiting || j.Status == RunStatus.Running || j.Status == RunStatus.GatheringVolumes) ?? 0;
        var runningJobsCount = statuses?.Count(s => s.Status != ParserStatus.Idle) ?? 0;
        var runAllDisabled = runningJobsCount > 0 || statuses?.All(s => !s.IsActive) == true;
    }
    <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="RunAllParsers" Disabled="@runAllDisabled">
        Run All
    </MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="CancelAllJobs" Disabled="@(cancellableJobsCount == 0)">
        Cancel All (@cancellableJobsCount)
    </MudButton>
</MudStack>

<MudTable Items="jobs" Hover="true" Breakpoint="Breakpoint.Sm">
    <HeaderContent>
        <MudTh></MudTh>
        <MudTh>Parser</MudTh>
        <MudTh>Created</MudTh>
        <MudTh>Started</MudTh>
        <MudTh>Status</MudTh>
        <MudTh>Finished</MudTh>
        <MudTh>Url</MudTh>
        <MudTh>Progress</MudTh>
        <MudTh>Error</MudTh>
    </HeaderContent>
    <RowTemplate Context="row">
        <MudTd>
            @{
                bool isCancelling = jobsPendingCancellation.Contains(row.Id);
                bool canCancel = (row.Status == RunStatus.Waiting || row.Status == RunStatus.Running || row.Status == RunStatus.GatheringVolumes) && !isCancelling;
            }
            @if (canCancel || isCancelling)
            {
                <MudIconButton Size="Size.Small" OnClick="(() => CancelJob(row.Id))" Icon="@Icons.Material.Rounded.Cancel" Color="Color.Error" Disabled="@isCancelling"></MudIconButton>
            }
        </MudTd>
        <MudTd DataLabel="Parser">@row.ParserStatus.ParserName</MudTd>
        <MudTd DataLabel="Created">@row.Created.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss.fff")</MudTd>
        <MudTd DataLabel="Started">@row.Started.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss.fff")</MudTd>
        @{
            var displayStatus = jobsPendingCancellation.Contains(row.Id) ? RunStatus.Cancelled : row.Status;
            var className = "cell-" + displayStatus;
        }
        <MudTd Class="@className" DataLabel="Status">@displayStatus</MudTd>
        <MudTd DataLabel="Finished">@row.Finished?.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss.fff")</MudTd>
        <MudTd DataLabel="Url">@row.Url</MudTd>
        <MudTd DataLabel="Progress">@row.Progress.ToString("N2")</MudTd>
        <MudTd DataLabel="Error">
            @foreach (var error in row.Errors)
            {
                @if (error.ExceptionMessage != null)
                {
                    <li>@error.Url @error.ExceptionMessage</li>
                }
                if (error.ErrorMessage != null)
                {
                    <li>@error.Url @error.ErrorMessage</li>
                }
            }
        </MudTd>
    </RowTemplate>
    <ChildRowContent>
        <MudStack Row Class="m-3">

            @if (context.AddedVolumes.Any())
            {
                <MudStack Spacing="0">
                    <MudText Typo="Typo.subtitle1">Added:@context.AddedVolumes.Count</MudText>
                    @if (showPanel)
                    {

                        @foreach (var item in context.AddedVolumes.OrderBy(x => x.FullName))
                        {
                            var addedVolume = "/volume/" + item.PublicId;
                            <MudLink Href="@addedVolume">@item.FullName</MudLink>
                        }
                    }
                </MudStack>
            }

            @if (context.UpdatedVolumes.Any())
            {
                <MudStack Spacing="0">
                    <MudText Typo="Typo.subtitle1">Updated:@context.UpdatedVolumes.Count</MudText>

                    @if (showPanel)
                    {



                        @foreach (var item in context.UpdatedVolumes.OrderBy(x => x.FullName))
                        {
                            var updatedVolume = "/volume/" + item.PublicId;
                            <MudLink Href="@updatedVolume">@item.FullName</MudLink>
                        }
                    }
                </MudStack>
            }
        </MudStack>
    </ChildRowContent>
</MudTable>





@code {
    bool showPanel = false;

    string url = null;
    CancellationTokenSource tokenSource = new();
    IEnumerable<ParserJob> jobs;
    IEnumerable<ParserStatusDto> statuses = null;
    System.DateTimeOffset lastCheckTime;
    private Dictionary<Guid, CancellationToken> jobDictionary = new();
    private const int LoadJobs = 20;
    private System.Timers.Timer countdownTimer;
    private Dictionary<Guid, string> countdownCache = new();
    private HashSet<Guid> jobsPendingCancellation = new();
    private HashSet<Guid> parsersPendingSubmission = new();

    protected override async Task OnInitializedAsync()
    {
        lastCheckTime = System.DateTimeOffset.Now;

        // Subscribe to job update events
        jobUpdateService.StatusesChanged += OnStatusesChanged;
        jobUpdateService.JobsChanged += OnJobsChanged;

        // Initialize with current data
        statuses = jobUpdateService.CurrentStatuses;
        jobs = jobUpdateService.CurrentJobs;

        // Start polling in the background
        _ = jobUpdateService.StartPollingAsync(tokenSource.Token);

        // Start countdown timer for real-time updates
        InitializeCountdownTimer();
    }

    private void InitializeCountdownTimer()
    {
        countdownTimer = new System.Timers.Timer(1000); // Update every 1 second
        countdownTimer.Elapsed += (sender, e) => UpdateCountdowns();
        countdownTimer.AutoReset = true;
        countdownTimer.Start();
    }

    private void UpdateCountdowns()
    {
        if (statuses == null) return;

        bool hasChanges = false;
        foreach (var parser in statuses)
        {
            var newText = CalculateCountdownText(parser.NextRun);

            if (!countdownCache.TryGetValue(parser.Id, out var oldText) || oldText != newText)
            {
                countdownCache[parser.Id] = newText;
                hasChanges = true;
            }
        }

        if (hasChanges)
        {
            InvokeAsync(() => StateHasChanged());
        }
    }

    private string CalculateCountdownText(DateTimeOffset nextRun)
    {
        var difference = nextRun - DateTimeOffset.Now;
        if (difference.TotalSeconds < 0)
        {
            return "0h 0m 0s";
        }
        return $"{(int)difference.TotalHours}h {difference.Minutes}m {difference.Seconds}s";
    }

    private string GetCountdownText(Guid parserId)
    {
        if (countdownCache.TryGetValue(parserId, out var text))
        {
            return text;
        }
        return "0h 0m 0s";
    }

    private void OnStatusesChanged(object? sender, ParserStatusesChangedEventArgs e)
    {
        statuses = e.NewStatuses;

        // Clear parsers from pending submission set if their status changed (indicating job was picked up)
        if (statuses != null && parsersPendingSubmission.Count > 0)
        {
            var pendingParsersWithStatusChanges = statuses
                .Where(s => parsersPendingSubmission.Contains(s.Id) && s.Status != ParserStatus.Idle)
                .Select(s => s.Id)
                .ToList();

            foreach (var parserId in pendingParsersWithStatusChanges)
            {
                parsersPendingSubmission.Remove(parserId);
            }
        }

        // Update cache with new values instead of clearing
        if (statuses != null)
        {
            foreach (var parser in statuses)
            {
                countdownCache[parser.Id] = CalculateCountdownText(parser.NextRun);
            }
        }
        StateHasChanged();
    }

    private void OnJobsChanged(object? sender, ParserJobsChangedEventArgs e)
    {
        jobs = e.NewJobs;

        // Remove jobs from pending cancellation set if they're confirmed as cancelled or finished
        var jobsToRemove = jobsPendingCancellation
            .Where(jobId => jobs.FirstOrDefault(j => j.Id == jobId) is { } job 
                && (job.Status == RunStatus.Cancelled || job.Status == RunStatus.Finished || job.Status == RunStatus.Error))
            .ToList();

        foreach (var jobId in jobsToRemove)
        {
            jobsPendingCancellation.Remove(jobId);
        }

        StateHasChanged();
    }

    public void Dispose()
    {
        // Stop countdown timer
        if (countdownTimer != null)
        {
            countdownTimer.Stop();
            countdownTimer.Dispose();
        }

        // Unsubscribe from events
        if (jobUpdateService != null)
        {
            jobUpdateService.StatusesChanged -= OnStatusesChanged;
            jobUpdateService.JobsChanged -= OnJobsChanged;
        }

        // Cancel polling
        if (tokenSource != null)
        {
            tokenSource.Cancel();
            tokenSource.Dispose();
        }
    }

    private async Task RunParser(Guid id)
    {
        // Mark this parser as having a pending job submission
        parsersPendingSubmission.Add(id);
        StateHasChanged();

        await jobManager.CreateParserJob(id);
        // Don't clear the pending set here - wait for server confirmation via OnJobsChanged
    }

    private async Task RunAllParsers()
    {
        if (statuses == null) return;

        // Get all active parsers that are idle
        var parsersToRun = statuses
            .Where(s => s.IsActive && s.Status == ParserStatus.Idle)
            .Select(s => s.Id)
            .ToList();

        if (parsersToRun.Count == 0) return;

        // Mark all parsers as having pending job submissions
        foreach (var parserId in parsersToRun)
        {
            parsersPendingSubmission.Add(parserId);
        }
        StateHasChanged();

        // Submit jobs for all parsers
        foreach (var parserId in parsersToRun)
        {
            await jobManager.CreateParserJob(parserId);
        }
    }

    private async Task RunForUrl(MouseEventArgs args)
    {
        try
        {
            if (Uri.IsWellFormedUriString(url, UriKind.Absolute))
            {
                await jobManager.CreateSingleJob(url);
            }
        }
        catch (Exception)
        {

        }

    }

    private async Task CancelJob(Guid? id)
    {
        if (id != null)
        {
            // Optimistically mark as cancelled locally
            jobsPendingCancellation.Add(id.Value);
            StateHasChanged();

            // Send cancellation request to server
            await jobManager.CancelJob(id.Value);
        }
    }

    private async Task CancelAllJobs()
    {
        if (jobs == null) return;

        // Get all jobs that can be cancelled
        var jobsToCancel = jobs
            .Where(j => j.Status == RunStatus.Waiting || j.Status == RunStatus.Running || j.Status == RunStatus.GatheringVolumes)
            .Select(j => j.Id)
            .ToList();

        if (jobsToCancel.Count == 0) return;

        // Mark all jobs as pending cancellation
        foreach (var jobId in jobsToCancel)
        {
            jobsPendingCancellation.Add(jobId);
        }
        StateHasChanged();

        // Send cancellation requests to server
        foreach (var jobId in jobsToCancel)
        {
            await jobManager.CancelJob(jobId);
        }
    }

    private async Task ToggleParserState(Guid id)
    {

        await parserService.ToggleParserStatus(id, tokenSource.Token);
    }
}