@page "/my-shelf"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization
@using MangaShelf.BL.Contracts
@using MangaShelf.BL.Services
@using MangaShelf.Common.Interfaces
@using MangaShelf.DAL.Models
@using MangaShelf.Components.Pages.VolumePage.Elements
@using MudBlazor

@inherits UserContextComponent

@inject IVolumeService VolumeService
@inject IDialogService DialogService
@inject IUiLocalizationService Localizer
@inject ISnackbar Snackbar

@attribute [Authorize]
@using static MangaShelf.Components.Pages.VolumePage.Elements.AddEditReadingDialog

<UserShelfFilterComponent FilterOptions="filterOptions" FilterOptionsChanged="ReloadVolumesAsync" />

@if (isLoading)
{
    <MudStack AlignItems="AlignItems.Center" Class="mt-8">
        <MudProgressCircular Indeterminate="true" Size="Size.Large" />
    </MudStack>
}
else if (volumes is null || !volumes.Any())
{
    <MudAlert Severity="Severity.Info">@Localizer["NoVolumesFound"]</MudAlert>
}
else
{
    <MudStack Spacing="2">
        @foreach (var seriesGroup in groupedSeries)
        {
            <MudPaper Elevation="1" Class="series-group pa-3 pa-sm-4">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                    <MudText Typo="Typo.h6">@seriesGroup.SeriesTitle</MudText>
                    <MudChip T="string" Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary">
                        @seriesGroup.Volumes.Count @(seriesGroup.Volumes.Count == 1 ? Localizer["VolumeCount"] : Localizer["VolumeCountPlural"])
                    </MudChip>
                </MudStack>

                <MudGrid Spacing="2">
                    @foreach (var volume in seriesGroup.Volumes)
                    {
                        <MudItem xs="6" sm="4" md="3" lg="2" xl="2">
                            <UserVolumeCardComponent VolumeCard="volume" OnCardClick="OpenVolumeModal" OnReadingStatusClick="OnReadingStatusClick" />
                        </MudItem>
                    }
                </MudGrid>
            </MudPaper>
        }
    </MudStack>
}

<style>
    .series-group {
        border-radius: 14px;
        background: color-mix(in srgb, var(--mud-palette-surface) 94%, var(--mud-palette-primary) 6%);
    }
</style>

@code {
    IEnumerable<UserVolumeCard>? volumes;
    List<SeriesVolumeGroup> groupedSeries = [];
    readonly UserShelfFilterOptions filterOptions = new();
    bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadVolumesAsync();
    }

    private async Task OpenVolumeModal(string publicId)
    {
        var parameters = new DialogParameters<VolumeQuickViewModal>
        {
            { x => x.PublicId, publicId }
        };

        var dialog = await DialogService.ShowAsync<VolumeQuickViewModal>("", parameters);
        await dialog.Result;

        // Refresh volumes after modal closes in case any data changed
        await LoadVolumesAsync();
    }

    private async Task OnReadingStatusClick(Guid volumeId)
    {
        var userId = await GetUserId();

        var reading = await VolumeService.GetActiveReading(volumeId, userId);

        if(reading == null)
        {
            reading = new Reading
            {
                VolumeId = volumeId,
                StartedAt = DateTime.UtcNow,
                Rating = 0
            };
        }

        reading.Status = ReadingStatus.Completed;
        reading.FinishedAt = DateTimeOffset.Now;

        var dialogOptions = new DialogOptions
        {
            FullWidth = true,
            Position = DialogPosition.Center,
            MaxWidth = MaxWidth.Small
        };

        var parameters = new DialogParameters
        {
            { nameof(AddEditReadingDialog.Reading), reading }
        };

        var dialog = await DialogService.ShowAsync<AddEditReadingDialog>("", parameters, dialogOptions);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            var resultData = result.Data as EditReadingDialogResult;
            if (resultData != null)
            {
                try
                {
                    await VolumeService.AddEditReadingAsync(resultData.Reading, userId);
                    await LoadVolumesAsync();
                }
                catch (Exception ex)
                {
                    Snackbar.Add($"Error saving reading: {ex.Message}", Severity.Error);
                }
            }
        }
    }

    private async Task ReloadVolumesAsync(UserShelfFilterOptions updatedFilterOptions)
    {
        filterOptions.SearchTerm = updatedFilterOptions.SearchTerm;
        filterOptions.CurrentOwnershipStatuses = updatedFilterOptions.CurrentOwnershipStatuses;
        filterOptions.CurrentReadingStatuses = updatedFilterOptions.CurrentReadingStatuses;
        filterOptions.IsLiked = updatedFilterOptions.IsLiked;
        filterOptions.MinRating = updatedFilterOptions.MinRating;
        filterOptions.MaxRating = updatedFilterOptions.MaxRating;

        await LoadVolumesAsync();
    }

    private async Task LoadVolumesAsync()
    {
        try
        {
            isLoading = true;
            var userId = await GetUserId();
            volumes = await VolumeService.GetUserVolumes(userId, filterOptions);
            groupedSeries = BuildSeriesGroups(volumes);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading user volumes: {ex.Message}");
            volumes = [];
            groupedSeries = [];
        }
        finally
        {
            isLoading = false;
        }
    }

    private List<SeriesVolumeGroup> BuildSeriesGroups(IEnumerable<UserVolumeCard>? userVolumes)
    {
        if (userVolumes is null)
        {
            return [];
        }

        return userVolumes
            .GroupBy(v => string.IsNullOrWhiteSpace(v.SeriesTitle) ? Localizer["UnknownSeries"] : v.SeriesTitle.Trim())
            .Select(group =>
            {
                var sortedVolumes = group
                    .OrderBy(v => !v.Number.HasValue)
                    .ThenBy(v => v.Number ?? int.MaxValue)
                    .ThenBy(v => v.ReleaseDate ?? DateTimeOffset.MaxValue)
                    .ToList();

                var latestRelease = group.Max(v => v.ReleaseDate ?? DateTimeOffset.MinValue);

                return new SeriesVolumeGroup
                {
                    SeriesTitle = group.Key,
                    LatestRelease = latestRelease,
                    Volumes = sortedVolumes
                };
            })
            .OrderByDescending(g => g.LatestRelease)
            .ThenBy(g => g.SeriesTitle)
            .ToList();
    }

    private sealed class SeriesVolumeGroup
    {
        public required string SeriesTitle { get; init; }
        public DateTimeOffset LatestRelease { get; init; }
        public required List<UserVolumeCard> Volumes { get; init; }
    }
}
