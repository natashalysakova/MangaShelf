@inject ISeriesService SeriesService
@inject IUiLocalizationService Localizer

<MudDialog>
    <TitleContent>
        <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.AutoAwesomeMotion" />
            <MudText Typo="Typo.h6">@($"{Localizer["Search"]} {Localizer["SeriesTitle"]}")</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3" Class="pt-2">
            <MudAutocomplete T="SeriesWithVolumesDto"
                             Label="@($"{Localizer["Search"]} {Localizer["SeriesTitle"]}")"
                             Value="_selectedSeries"
                             ValueChanged="OnSeriesSelected"
                             SearchFunc="SearchSeriesAsync"
                             ToStringFunc="FormatSeries"
                             Variant="Variant.Outlined"
                             Clearable="true"
                             ResetValueOnEmptyText="true"
                             CoerceValue="false"
                             AdornmentIcon="@Icons.Material.Filled.Search"
                             AdornmentColor="Color.Primary"
                             Placeholder="@Localizer["SearchPlaceholder"]">
            </MudAutocomplete>

            @if (_selectedSeries != null)
            {
                <MudPaper Class="pa-3" Outlined="true">
                    <MudStack Spacing="2">
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.subtitle1">@_selectedSeries.Title</MudText>
                            @if (!string.IsNullOrWhiteSpace(_selectedSeries.OriginalTitle))
                            {
                                <MudText Typo="Typo.body2">@_selectedSeries.OriginalTitle</MudText>
                            }
                            <MudText Typo="Typo.caption">@_selectedSeries.PublicId</MudText>
                        </MudStack>

                        <MudText Typo="Typo.subtitle2">@Localizer["VolumeDetails"]</MudText>
                        @if (_selectedSeries.Volumes.Any())
                        {
                            <MudChipSet T="string">
                                @foreach (var volume in _selectedSeries.Volumes)
                                {
                                    <MudChip T="string" Variant="Variant.Outlined" Value="@volume.PublicId" Icon="@Icons.Material.Filled.Book">
                                        @FormatVolume(volume)
                                    </MudChip>
                                }
                            </MudChipSet>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2">No volumes yet.</MudText>
                        }
                    </MudStack>
                </MudPaper>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@Localizer["Cancel"]</MudButton>
        <MudButton OnClick="Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="_selectedSeries is null">@Localizer["Apply"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public Guid CurrentSeriesId { get; set; }

    private SeriesWithVolumesDto? _selectedSeries;

    private async Task<IEnumerable<SeriesWithVolumesDto>> SearchSeriesAsync(string value, CancellationToken token)
    {
        var results = await SeriesService.SearchAsync(value, token);
        return results.Where(series => series.Id != CurrentSeriesId);
    }

    private void OnSeriesSelected(SeriesWithVolumesDto? series)
    {
        _selectedSeries = series;
    }

    private string FormatSeries(SeriesWithVolumesDto? series)
    {
        if (series == null)
        {
            return string.Empty;
        }

        var originalTitle = string.IsNullOrWhiteSpace(series.OriginalTitle)
            ? string.Empty
            : $" / {series.OriginalTitle}";

        return $"{series.Title}{originalTitle} ({series.PublicId})";
    }

    private static string FormatVolume(CardVolumeDto volume)
    {
        if (volume.Number > 0)
        {
            return $"Vol. {volume.Number}";
        }

        return string.IsNullOrWhiteSpace(volume.Title)
            ? volume.PublicId
            : volume.Title;
    }

    private void Submit()
    {
        if (_selectedSeries == null)
        {
            return;
        }

        MudDialog.Close(DialogResult.Ok(_selectedSeries));
    }

    private void Cancel() => MudDialog.Cancel();
}
